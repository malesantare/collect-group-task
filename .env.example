HOST=127.0.0.1
PORT=3000
WALLET_COUNT=5
# Sepolia only; the RPC chain ID is checked at runtime.
CHAIN_ID=11155111
# Run npm run setup:env to create .env with a fresh test-only phrase.
# If configuring manually, supply your own test-only English BIP-39 mnemonic.
MNEMONIC=
# npm run setup:db adds a generated DB password and DATABASE_URL to an existing .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POLL_INTERVAL_MS=60000
RPC_TIMEOUT_MS=10000
# npm run setup:withdrawals generates this API credential in .env.
WITHDRAWAL_API_KEY=
